gfm_cluster_restart = /usr/local/bin/gfm_control.sh /etc/gorgona/gfm_pg_prod2_5433.conf restart_gfm
gfm_cluster_health   = /usr/local/bin/gfm_health.sh /etc/gorgona/gfm_pg_prod2_5433.conf
gfm_cluster_switch   = /usr/local/bin/gfm_switchover.sh /etc/gorgona/gfm_pg_prod2_5433.conf
# умный rebuild реплики ip второй ноды необязательный параметр, нужен для начального ребилда
