# cat /etc/gorgona/gorgona.conf 

[server]
ip = 192.168.1.170
port = 7777
sync_psk = BQQCyN8zo4La2lRSIQ2jLp5imEa0JzdXp2PKogP3

[exec_commands:zpPVK9fbEqo=]
gorgonad1_down = /usr/bin/systemctl stop postgresql
gorgonad1_promote   = /usr/bin/sudo -u postgres /usr/bin/pg_ctlcluster 17 main promote
# Обязательно добавьте команду старта (чтобы вернуть узел в строй после step_down)
gorgonad1_start     = /usr/bin/systemctl start postgresql
# Команда для получения статуса (чтобы видеть JSON прямо в меше)
gorgonad1_status    = /usr/bin/cat /etc/gorgona/cluster_status.json
# Перезапуск менеджера (если изменили код gfm.py и хотите обновить без SSH)
gfm_restart         = /usr/bin/systemctl restart gfm
# умный rebuild реплики
gorgonad1_rebuild = /usr/local/bin/gfm_rebuild.sh 192.168.1.171
# Команда для переезда (узел отдаст роль мастера и станет репликой)
gfm_switchover = /usr/local/bin/gfm_switchover.sh
# Здоровье узла
gfm_health = /usr/local/bin/gfm_health.sh


